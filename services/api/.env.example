PORT=3000
HOST=127.0.0.1
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=maridao
PGUSER=maridao_api
PGPASSWORD="PREENCHA_AQUI"

# Duas chaves diferentes, cada uma com 64 caracteres hexadecimais. Nunca enviar ao Git.
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_INDEX_KEY=

# Chave independente para mensagens do chat, 64 caracteres hexadecimais.
CHAT_ENCRYPTION_KEY=
# Atrás de um proxy (ex.: Render), quantos saltos confiar para saber o IP do cliente. Vazio no computador local.
# No Render: TRUST_PROXY=1. Sem isso, todo mundo divide o mesmo limite de 10 tentativas por 15 minutos.
TRUST_PROXY=

# Versão web do aplicativo (navegador): endereços que podem chamar a API, separados por vírgula, sem barra no fim.
# Vazio = só o aplicativo nativo. Exemplo local: http://localhost:8081 (WEB_ORIGIN, com um endereço só, também vale).
WEB_ORIGINS=

# local grava somente e-mails fictícios de teste em .local-mail/; não envia e-mail real.
# O modo local é recusado quando NODE_ENV=production.
MAIL_MODE=local

# Envio real: configurar pelo terminal com npm run mail:configure.
# Usar senha de aplicativo, nunca a senha principal da conta Gmail.
# MAIL_MODE=smtp
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

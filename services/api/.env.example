PORT=3000
HOST=127.0.0.1
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=maridao
PGUSER=maridao_api
PGPASSWORD="PREENCHA_AQUI"

# Duas chaves diferentes, cada uma com 64 caracteres hexadecimais. Nunca enviar ao Git.
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_INDEX_KEY=

# Chave independente para mensagens do chat, 64 caracteres hexadecimais.
CHAT_ENCRYPTION_KEY=
# Envio do código de recuperação de senha e de confirmação de e-mail.
# local: grava somente e-mails fictícios de teste em .local-mail/; não envia e-mail real. É recusado quando NODE_ENV=production.
# smtp: envia de verdade pelo servidor abaixo. Sem MAIL_MODE (ou com dados incompletos) a API responde 503 nessas rotas.
MAIL_MODE=local

# Usados só com MAIL_MODE=smtp. Preencha no .env com os dados do seu provedor; nunca envie a senha ao Git.
# SMTP_PORT: 587 (padrão, STARTTLS obrigatório) ou 465 (TLS desde a conexão; SMTP_SECURE passa a valer true).
# SMTP_USER e SMTP_PASSWORD: os dois ou nenhum. MAIL_FROM: remetente, "nome <endereco>" ou só o endereço.
# SMTP_REQUIRE_TLS=false só é aceito fora de produção, para servidor de teste na própria máquina.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
